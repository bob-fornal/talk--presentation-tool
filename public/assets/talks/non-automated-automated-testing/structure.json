  "what-is-manual-testing": {
    "title": "What is Manual Testing?",
    "type": "image-text",
    "orientation": "left",
    "text1": "<div class=green-bold>Manual Testing</div> <div class=div-wrapper>The process of testing software applications by hand, <span class=yellow>without the use of automated tools</span>. Testers manually execute test cases, simulating how an end-user would interact with the software, and <span class=yellow>verify the results against expected outcomes</span>. This method is crucial for identifying defects and ensuring software quality before release.</div> <div class=orange-bold>Key Aspects:</div> <ul> <li>No Automation</li> <li>Exploratory Testing</li> <li>Usability Testing</li> <li>Regression Testing</li> <li>Versatility</li> </ul>",
    "image": "./assets/images/cars-manual.jpg"
  },
  "what-is-automated-testing": {
    "title": "What is Automated Testing?",
    "type": "image-text",
    "orientation": "left",
    "text1": "<div class=green-bold>Automated Testing</div> <div class=div-wrapper>A software testing methodology that utilizes specialized tools and scripts to execute test cases and compare <span class=yellow>actual results against expected outcomes</span>, with <span class=yellow>minimal or no human intervention</span> during the execution phase. This contrasts with <span class=orange>manual testing</span>, where human testers manually interact with the software to identify defects.</div> <div class=orange-bold>Core Principles:</div> <ul> <li>Test Script Creation</li> <li>Automated Execution</li> <li>Results Analysis</li> </ul> <ul> <li>Unit Tests</li> <li>Integration Tests</li> <li>End-to-End Tests</li> </ul>",
    "image": "./assets/images/cars-automation.jpg"
  },

